{
  "name": "provtrace-ts",
  "version": "0.1.0",
  "description": "Provenance Tracer (ProvTrace) - W3C PROV process mining prototype for software development",
  "type": "module",
  "scripts": {
    "seed": "tsx scripts/seed-target-repo.ts",
    "extract": "node --no-warnings --import tsx src/cli-extract.ts",
    "dev": "node --no-warnings --import tsx --watch src/index.tsx",
    "start": "node --no-warnings --import tsx src/index.tsx",
    "test": "node --no-warnings --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "hono": "^4.7.4"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
